POSTGRES_USER=platform
POSTGRES_PASSWORD=platform_secret
POSTGRES_DB=platform_db
# ENVIRONMENT: development | staging | production. Only "production" requires
# a Bearer token on every request (otherwise anonymous calls run as dev-user).
# Only "development" allows the placeholder secrets below; with any other value
# the services refuse to start while a secret below is a placeholder or shorter than 32
# characters: api-gateway, storage-service and ssh-executor check JWT_SECRET,
# ssh-executor also checks SSH_CRED_KEY.
ENVIRONMENT=development
# Signs user JWTs and internal service-to-service JWTs. Outside development
# this MUST be a long random string (32+ chars), e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_in_production
DATABASE_URL=postgresql://platform:platform_secret@postgres:5432/platform_db
HDFS_WEBHDFS_URL=http://namenode:9870
HDFS_USER=hadoop
# At-rest encryption key for stored SSH credentials (ssh-executor).
# Outside development this MUST be a long random string (32+ chars).
SSH_CRED_KEY=change_me_ssh_cred_key
