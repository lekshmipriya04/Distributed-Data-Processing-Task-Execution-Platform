{
  "name": "distributed-compute",
  "displayName": "Distributed Compute",
  "description": "Run code and train models on your own machines over SSH, entirely from VS Code: one-click local setup, add and manage workers, run any language in parallel with live output, and train built-in, custom or Spark models.",
  "version": "1.0.0",
  "publisher": "aaron43210",
  "author": "AARON R, M R LEKSHMI PRIYA, ALEENA VJ",
  "contributors": [
    "AARON R",
    "M R LEKSHMI PRIYA",
    "ALEENA VJ"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lekshmipriya04/Distributed-Data-Processing-Task-Execution-Platform.git"
  },
  "bugs": {
    "url": "https://github.com/lekshmipriya04/Distributed-Data-Processing-Task-Execution-Platform/issues"
  },
  "homepage": "https://github.com/lekshmipriya04/Distributed-Data-Processing-Task-Execution-Platform#readme",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other", "Machine Learning", "Visualization"],
  "keywords": ["distributed", "compute", "ssh", "remote execution", "machine learning"],
  "icon": "media/icons/distributed-compute.png",
  "activationEvents": [
    "onStartupFinished",
    "onView:distributedCompute.nodes",
    "onView:distributedCompute.jobs",
    "onView:distributedCompute.executions",
    "onView:distributedCompute.training"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "distributedCompute",
          "title": "Distributed Compute",
          "icon": "media/icons/activity.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "distributedCompute.nodes",
        "contents": "Not connected to a master.\n[$(rocket) Set Up Platform on This Computer](command:distributedCompute.setUpPlatform)\nDocker builds and starts everything, then VS Code connects. Nothing to type.\n[Connect to Another Master](command:distributedCompute.configureMaster)",
        "when": "!distributedCompute.connected"
      },
      {
        "view": "distributedCompute.nodes",
        "contents": "No worker machines yet. A worker needs only SSH and Python; nothing is installed on it.\n[$(add) Add Compute Node](command:distributedCompute.addNode)",
        "when": "distributedCompute.connected"
      }
    ],
    "walkthroughs": [
      {
        "id": "distributedCompute.getStarted",
        "title": "Get Started with Distributed Compute",
        "description": "Run code and train models on your own machines, in three clicks.",
        "steps": [
          {
            "id": "setUp",
            "title": "Start the platform",
            "description": "One click. VS Code checks Docker (and starts Docker Desktop), downloads the platform if needed, starts it and connects.\n[Set Up Platform](command:distributedCompute.setUpPlatform)",
            "media": { "markdown": "media/walkthrough/setup.md" },
            "completionEvents": ["onContext:distributedCompute.connected"]
          },
          {
            "id": "addWorker",
            "title": "Add a worker machine",
            "description": "Enter the machine's address, user and SSH password, once. VS Code checks its host key, installs a restricted key and detects its hardware.\n[Add Compute Node](command:distributedCompute.addNode)",
            "media": { "markdown": "media/walkthrough/workers.md" },
            "completionEvents": ["onCommand:distributedCompute.addNode"]
          },
          {
            "id": "run",
            "title": "Run code or train a model",
            "description": "Open any file and run it on your workers, as one task or many in parallel, or train a model. Output streams in live.\n[Run File in Parallel](command:distributedCompute.runDistributed)\n[Train a Model](command:distributedCompute.submitTraining)",
            "media": { "markdown": "media/walkthrough/run.md" },
            "completionEvents": ["onCommand:distributedCompute.runDistributed", "onCommand:distributedCompute.runWithRuntime", "onCommand:distributedCompute.submitTraining"]
          }
        ]
      }
    ],
    "views": {
      "distributedCompute": [
        { "id": "distributedCompute.nodes", "name": "Compute Nodes" },
        { "id": "distributedCompute.jobs", "name": "Jobs" },
        { "id": "distributedCompute.executions", "name": "Executions" },
        { "id": "distributedCompute.training", "name": "Training Runs" }
      ]
    },
    "commands": [
      { "command": "distributedCompute.setUpPlatform", "title": "Distributed Compute: Set Up Platform on This Computer", "icon": "$(rocket)" },
      { "command": "distributedCompute.stopPlatform", "title": "Distributed Compute: Stop Platform on This Computer" },
      { "command": "distributedCompute.openDashboard", "title": "Distributed Compute: Open Dashboard" },
      { "command": "distributedCompute.connect", "title": "Distributed Compute: Connect to Master" },
      { "command": "distributedCompute.disconnect", "title": "Distributed Compute: Disconnect from Master" },
      { "command": "distributedCompute.configureMaster", "title": "Distributed Compute: Configure Master URL" },
      { "command": "distributedCompute.configureAuth", "title": "Distributed Compute: Configure Authentication" },
      { "command": "distributedCompute.showConnectionStatus", "title": "Distributed Compute: Show Connection Status" },
      { "command": "distributedCompute.refreshState", "title": "Distributed Compute: Refresh Platform State", "icon": "$(refresh)" },
      { "command": "distributedCompute.addNode", "title": "Distributed Compute: Add Compute Node", "icon": "$(add)" },
      { "command": "distributedCompute.refreshNodes", "title": "Distributed Compute: Refresh Nodes", "icon": "$(refresh)" },
      { "command": "distributedCompute.testNode", "title": "Distributed Compute: Test Node Connection" },
      { "command": "distributedCompute.refreshNodeCapabilities", "title": "Distributed Compute: Detect Node Hardware Again" },
      { "command": "distributedCompute.rotateNodeKey", "title": "Distributed Compute: Rotate Node Key" },
      { "command": "distributedCompute.viewNode", "title": "Distributed Compute: View Node Details" },
      { "command": "distributedCompute.configureSlice", "title": "Distributed Compute: Configure Resource Slice" },
      { "command": "distributedCompute.drainNode", "title": "Distributed Compute: Drain Node" },
      { "command": "distributedCompute.resumeNode", "title": "Distributed Compute: Resume Node" },
      { "command": "distributedCompute.removeNode", "title": "Distributed Compute: Remove Node" },
      { "command": "distributedCompute.runDistributed", "title": "Distributed Compute: Run File in Parallel…", "icon": "$(run-all)" },
      { "command": "distributedCompute.runPythonFile", "title": "Distributed Compute: Run Python File" },
      { "command": "distributedCompute.runWithRuntime", "title": "Distributed Compute: Run File with Runtime…" },
      { "command": "distributedCompute.submitTraining", "title": "Distributed Compute: Submit Training Job", "icon": "$(play)" },
      { "command": "distributedCompute.trainWithModelFile", "title": "Distributed Compute: Train with This Model File" },
      { "command": "distributedCompute.trainOnDataset", "title": "Distributed Compute: Train on This Dataset" },
      { "command": "distributedCompute.runTrainingAgain", "title": "Distributed Compute: Run Training Again", "icon": "$(debug-rerun)" },
      { "command": "distributedCompute.newCustomModel", "title": "Distributed Compute: New Custom Model File" },
      { "command": "distributedCompute.enableSparkRay", "title": "Distributed Compute: Enable Spark + Ray Engine" },
      { "command": "distributedCompute.disableSparkRay", "title": "Distributed Compute: Disable Spark + Ray Engine" },
      { "command": "distributedCompute.downloadModel", "title": "Download Trained Model", "icon": "$(cloud-download)" },
      { "command": "distributedCompute.showTrainingRun", "title": "Show Run Details" },
      { "command": "distributedCompute.deleteTrainingRun", "title": "Delete Training Run" },
      { "command": "distributedCompute.refreshTraining", "title": "Distributed Compute: Refresh Training Runs", "icon": "$(refresh)" },
      { "command": "distributedCompute.viewJobs", "title": "Distributed Compute: View Jobs" },
      { "command": "distributedCompute.viewLogs", "title": "Distributed Compute: View Execution Output" },
      { "command": "distributedCompute.cancelExecution", "title": "Distributed Compute: Cancel Execution" },
      { "command": "distributedCompute.retryExecution", "title": "Distributed Compute: Retry Execution" },
      { "command": "distributedCompute.retrieveResults", "title": "Distributed Compute: Save Execution Results" },
      { "command": "distributedCompute.initProject", "title": "Distributed Compute: Initialize Project" },
      { "command": "distributedCompute.validateProject", "title": "Distributed Compute: Validate Project Configuration" },
      { "command": "distributedCompute.showCluster", "title": "Distributed Compute: Show Cluster Status" },
      { "command": "distributedCompute.showDiagnostics", "title": "Distributed Compute: Show Diagnostics" }
    ],
    "configuration": {
        "title": "Distributed Compute",
        "properties": {
          "distributedCompute.masterUrl": {
            "type": "string",
            "default": "http://localhost:8090",
            "description": "Base URL of the extension gateway. The default is a master started on this machine with docker compose. Use https:// for remote hosts; http:// is allowed only for local or LAN hosts."
          },
          "distributedCompute.autoConnect": {
            "type": "boolean",
            "default": false,
            "description": "Attempt to connect to the configured master on activation."
          },
          "distributedCompute.refreshIntervalSeconds": {
            "type": "number",
            "default": 15,
            "minimum": 5,
            "description": "Polling interval for platform state (minimum 5s)."
          },
          "distributedCompute.enableCodeLens": {
            "type": "boolean",
            "default": true,
            "description": "Show Run Distributed CodeLens on configured entrypoints."
          },
          "distributedCompute.defaultRuntime": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.+-]{0,31}$",
            "default": "python",
            "description": "Default runtime id for new jobs (any id from GET /runtimes that is detected on your nodes, e.g. python, bash, node, go)."
          },
          "distributedCompute.defaultTimeoutSeconds": {
            "type": "number",
            "default": 600,
            "minimum": 1,
            "description": "Default job timeout in seconds."
          },
          "distributedCompute.executionPolicy": {
            "type": "string",
            "enum": [
              "safe_background",
              "balanced",
              "max_available"
            ],
            "enumDescriptions": [
              "Low priority; never starve the worker owner",
              "Normal priority within the allocated slice",
              "Use the full allocated slice"
            ],
            "default": "safe_background",
            "description": "How hard submitted executions may use each worker's lent slice."
          },
          "distributedCompute.showNotifications": {
            "type": "boolean",
            "default": true,
            "description": "Show job lifecycle notifications."
          },
          "distributedCompute.logLevel": {
            "type": "string",
            "enum": [
              "error",
              "warn",
              "info",
              "debug"
            ],
            "default": "info",
            "description": "Diagnostics Output Channel verbosity."
          },
          "distributedCompute.training.defaultEngine": {
            "type": "string",
            "enum": [
              "python",
              "spark_ray"
            ],
            "enumDescriptions": [
              "Pure Python: nothing extra to install",
              "Apache Spark + Ray on the master (installed on request)"
            ],
            "default": "python",
            "description": "Engine offered first by Submit Training Job."
          },
          "distributedCompute.training.defaultRounds": {
            "type": "number",
            "default": 3,
            "minimum": 1,
            "description": "Federated rounds (the master averages the model after each)."
          },
          "distributedCompute.training.defaultEpochs": {
            "type": "number",
            "default": 10,
            "minimum": 1,
            "description": "Epochs each worker runs per round."
          },
          "distributedCompute.training.defaultLearningRate": {
            "type": "number",
            "default": 0.01,
            "exclusiveMinimum": 0,
            "description": "Learning rate for built-in and custom models."
          },
          "distributedCompute.autoStartPlatform": {
            "type": "boolean",
            "default": true,
            "description": "After the platform has been set up on this computer, start its Docker containers (and Docker Desktop, if needed) when VS Code opens, then connect."
          },
          "distributedCompute.platformPath": {
            "type": "string",
            "default": "",
            "description": "Folder with the platform's docker-compose.yml. Used to install Spark + Ray on a master running on this machine; found automatically when empty."
          }
        }
      },
    "jsonValidation": [
      { "fileMatch": "distributed.json", "url": "./schemas/distributed.schema.json" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "distributedCompute.viewNode", "when": "false" },
        { "command": "distributedCompute.configureSlice", "when": "false" },
        { "command": "distributedCompute.downloadModel", "when": "false" },
        { "command": "distributedCompute.showTrainingRun", "when": "false" },
        { "command": "distributedCompute.deleteTrainingRun", "when": "false" },
        { "command": "distributedCompute.trainWithModelFile", "when": "editorLangId == python" }
      ],
      "view/title": [
        { "command": "distributedCompute.refreshNodes", "when": "view == distributedCompute.nodes", "group": "navigation" },
        { "command": "distributedCompute.addNode", "when": "view == distributedCompute.nodes", "group": "navigation" },
        { "command": "distributedCompute.runDistributed", "when": "view == distributedCompute.jobs", "group": "navigation@1" },
        { "command": "distributedCompute.refreshState", "when": "view == distributedCompute.jobs", "group": "navigation" },
        { "command": "distributedCompute.refreshState", "when": "view == distributedCompute.executions", "group": "navigation" },
        { "command": "distributedCompute.submitTraining", "when": "view == distributedCompute.training", "group": "navigation@1" },
        { "command": "distributedCompute.runTrainingAgain", "when": "view == distributedCompute.training", "group": "navigation@2" },
        { "command": "distributedCompute.refreshTraining", "when": "view == distributedCompute.training", "group": "navigation@3" }
      ],
      "view/item/context": [
        { "command": "distributedCompute.viewNode", "when": "view == distributedCompute.nodes && viewItem =~ /^node:/", "group": "inline" },
        { "command": "distributedCompute.configureSlice", "when": "view == distributedCompute.nodes && viewItem =~ /^node:/" },
        { "command": "distributedCompute.drainNode", "when": "view == distributedCompute.nodes && viewItem =~ /^node:(online|busy|degraded)$/" },
        { "command": "distributedCompute.resumeNode", "when": "view == distributedCompute.nodes && viewItem == node:draining" },
        { "command": "distributedCompute.testNode", "when": "view == distributedCompute.nodes && viewItem =~ /^node:/", "group": "1_node@1" },
        { "command": "distributedCompute.refreshNodeCapabilities", "when": "view == distributedCompute.nodes && viewItem =~ /^node:/", "group": "1_node@2" },
        { "command": "distributedCompute.rotateNodeKey", "when": "view == distributedCompute.nodes && viewItem =~ /^node:/", "group": "1_node@3" },
        { "command": "distributedCompute.removeNode", "when": "view == distributedCompute.nodes && viewItem =~ /^node:/", "group": "9_danger@1" },
        { "command": "distributedCompute.viewLogs", "when": "viewItem =~ /^execution:/" },
        { "command": "distributedCompute.cancelExecution", "when": "viewItem =~ /^execution:.*:active$/" },
        { "command": "distributedCompute.retryExecution", "when": "viewItem =~ /^execution:.*:terminal$/" },
        { "command": "distributedCompute.retrieveResults", "when": "viewItem =~ /^execution:.*:terminal$/" },
        { "command": "distributedCompute.downloadModel", "when": "view == distributedCompute.training && viewItem =~ /^training:completed:/", "group": "inline" },
        { "command": "distributedCompute.downloadModel", "when": "view == distributedCompute.training && viewItem =~ /^training:completed:/", "group": "1_run@1" },
        { "command": "distributedCompute.showTrainingRun", "when": "view == distributedCompute.training && viewItem =~ /^training:/", "group": "1_run@2" },
        { "command": "distributedCompute.deleteTrainingRun", "when": "view == distributedCompute.training && viewItem =~ /^training:.*:terminal:/", "group": "2_danger@1" }
      ],
      "explorer/context": [
        { "command": "distributedCompute.trainOnDataset", "when": "resourceExtname =~ /^\\.(csv|json|jsonl|parquet)$/", "group": "distributedCompute@1" },
        { "command": "distributedCompute.trainWithModelFile", "when": "resourceLangId == python", "group": "distributedCompute@2" }
      ],
      "editor/context": [
        { "command": "distributedCompute.runPythonFile", "when": "resourceLangId == python", "group": "distributedCompute@1" },
        { "command": "distributedCompute.runWithRuntime", "group": "distributedCompute@2" },
        { "command": "distributedCompute.runDistributed", "group": "distributedCompute@2" },
        { "command": "distributedCompute.trainWithModelFile", "when": "resourceLangId == python", "group": "distributedCompute@3" }
      ]
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "compile": "npm run typecheck && node ./esbuild.js",
    "build:prod": "npm run clean && npm run typecheck && node ./esbuild.js --production",
    "watch": "node ./esbuild.js --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p ./",
    "test": "vitest run",
    "vscode:prepublish": "npm run build:prod",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.26.0",
    "esbuild": "^0.21.0",
    "eslint": "^9.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.6.0"
  }
}
